{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loam.invalid/schemas/pilot-manifest-1.0.json",
  "title": "Loam two-fleet pilot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phase", "fleets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "phase": { "enum": ["baseline", "exit"] },
    "fleets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "profile", "workDir", "criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "profile": { "enum": ["brownfield-adoption", "active-cross-service"] },
          "workDir": { "type": "string", "minLength": 1 },
          "criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minServices", "minMaturityStates", "minActiveFeatures", "minCrossServiceFeatures", "maxValidateMs", "requireDoctorHealthy", "requireValid"],
            "properties": {
              "minServices": { "type": "integer", "minimum": 0 },
              "minMaturityStates": { "type": "integer", "minimum": 0 },
              "minActiveFeatures": { "type": "integer", "minimum": 0 },
              "minCrossServiceFeatures": { "type": "integer", "minimum": 0 },
              "maxValidateMs": { "type": "integer", "exclusiveMinimum": 0 },
              "requireDoctorHealthy": { "type": "boolean" },
              "requireValid": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "exit" } },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "fleets": {
            "items": {
              "properties": {
                "criteria": {
                  "properties": {
                    "requireDoctorHealthy": { "const": true },
                    "requireValid": { "const": true }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
