// generated by loam — the subsystem tree under services/, one view per subsystem.
// Do not edit: `loam subsystem sync` regenerates this file from the directories,
// and `loam validate --all` reports `subsystem.views-stale` when it drifts.

views {
  // services/platform
  view subsystem_platform {
    include marketplace.identityService
    include marketplace.notificationService
  }
}
