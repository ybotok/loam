views {
  view service_checkout_2dweb of marketplace.checkoutWeb {
    title 'checkout-web'
    include *
    include customer
    include marketplace.orderService
    include marketplace.paymentService
    exclude * -> *
    include -> marketplace.checkoutWeb
    include marketplace.checkoutWeb ->
    include marketplace.checkoutWeb.* -> marketplace.checkoutWeb.*
  }

  view service_identity_2dservice of marketplace.identityService {
    title 'Platform / identity-service'
    include *
    include marketplace.orderService
    include marketplace.paymentService
    exclude * -> *
    include -> marketplace.identityService
    include marketplace.identityService ->
    include marketplace.identityService.* -> marketplace.identityService.*
  }

  view service_notification_2dservice of marketplace.notificationService {
    title 'Platform / notification-service'
    include *
    include kafka.crmEvents
    include kafka.orderEvents
    include kafka.paymentEvents
    include notificationProvider
    exclude * -> *
    include -> marketplace.notificationService
    include marketplace.notificationService ->
    include marketplace.notificationService.* -> marketplace.notificationService.*
  }

  view service_order_2dservice of marketplace.orderService {
    title 'order-service'
    include *
    include kafka.orderEvents
    include kafka.paymentEvents
    include marketplace.checkoutWeb
    include marketplace.identityService
    include marketplace.paymentService
    exclude * -> *
    include -> marketplace.orderService
    include marketplace.orderService ->
    include marketplace.orderService.* -> marketplace.orderService.*
  }

  view service_payment_2dservice of marketplace.paymentService {
    title 'payment-service'
    include *
