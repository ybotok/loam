// generated by loam — the platform above its subsystems: a context view and an inside view per root.
// Do not edit: `loam views` regenerates this file from the fleet map,
// and `loam validate --all` reports `subsystem.views-stale` when it drifts.
// The edges titled `async:` are events, derived from the spine's keys and topics; nothing in loam reads them back.
// An event drawn only as edges to a broker, with no message key and no topic, is not derived.

views {
  // marketplace
  // 3 event pair(s) end at a box of this root that is not a subsystem group, and no edge is derived for them: a relationship is drawn in every view naming both its ends, so it would surface in every per-service and hand-drawn view of those boxes.
  view platform_marketplace_context {
    title 'Marketplace — context'
    description 'The platform as one box, and every person and system an edge joins to it. Stores, caches and topics are left out.'
    include marketplace
    include customer
    include kafka
    include notificationProvider
    include stripe
  }

  view platform_marketplace of marketplace {
    title 'Marketplace — inside'
    description 'The subsystems of the platform and the people who reach them. Edges titled async are events, derived from the spine.'
    include marketplace.checkoutWeb
    include marketplace.identityService
    include marketplace.notificationService
    include marketplace.orderService
    include marketplace.paymentService
    include customer
  }
}
