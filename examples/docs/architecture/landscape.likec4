// Global C4 fleet landscape. Self-contained for now; cross-file merge (fromWorkspace)
// is how loam will aggregate the real landscape from per-service files later.
specification {
  element softwareSystem
  element person
  tag FEAT-101
}

model {
  customer = person 'Customer'
  checkoutWeb = softwareSystem 'checkout-web' {
    description 'Customer-facing checkout UI'
  }
  paymentService = softwareSystem 'payment-service' {
    description 'Owns payment authorization/capture'
  }
  kafka = softwareSystem 'kafka' {
    description 'Event backbone'
  }
  paymentSplitService = softwareSystem 'payment-split-service' {
    #FEAT-101
    description 'Splits a payment across payees'
  }

  customer -> checkoutWeb 'Uses'
  checkoutWeb -> paymentService 'Calls'
  paymentService -> kafka 'Publishes PaymentAuthorized'

  paymentService -> paymentSplitService 'Calls createSplit' { #FEAT-101 }
  checkoutWeb -> paymentSplitService 'Calls createSplit' { #FEAT-101 }
  paymentSplitService -> kafka 'Publishes PaymentSplit' { #FEAT-101 }
}

views {
  view landscape {
    include *
  }
}
