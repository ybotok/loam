// Global C4 fleet landscape — the LIVING current state (before FEAT-101 is archived).
// `loam archive` folds a feature's #FEAT-tagged elements/relationships in here.
// One landscape file, by decision: conflicts resolve through PRs. See SCHEMA.md,
// "Operating at fleet scale", for the trigger that would change this.
//
// `loam validate --all` cross-checks this file against services/: every service
// directory needs an element here (error), and every element that looks like a
// service needs a directory (warning). An element is tied to its directory by
// `metadata { service '<id>' }`, or by its title when there is no binding.
// Systems that are not ours carry #external and are exempt.
specification {
  element softwareSystem
  // Declared here because archive SPLICES a delta's additions verbatim: FEAT-101's
  // new system carries its `api` container along, and the kind has to be legal in
  // THIS document for the merged landscape to parse (archive refuses otherwise).
  element container
  element person
  // A topic is an element, and the kind carries #external rather than each
  // instance doing it: LikeC4 does NOT inherit tags, so a topic nested inside
  // the #external broker is not external itself, and `loam validate --all`
  // would ask for a services/payment.events/ nobody owes
  // (`landscape.service-undocumented`).
  element topic {
    #external
    style {
      shape queue
    }
  }
  tag external
}

model {
  customer = person 'Customer'
  checkoutWeb = softwareSystem 'checkout-web' {
    description 'Customer-facing checkout UI'
    metadata {
      service 'checkout-web'
    }
  }
  paymentService = softwareSystem 'payment-service' {
    description 'Owns payment authorization/capture'
    metadata {
      service 'payment-service'
    }
  }
  kafka = softwareSystem 'kafka' {
    // Not one of ours: no services/kafka/ is expected, and none is asked for.
    #external
    description 'Event backbone'
    // Edges point HERE, not at the broker. Two producers make no difference;
    // sixty do — a broker drawn as one element is the node every service in the
    // fleet points at, and a view over it is a star nobody can read. The topic
    // is also the truer target: what a producer and a consumer share is the
    // channel, never the server it happens to live on.
    paymentEvents = topic 'payment.events'
  }

  customer -> checkoutWeb 'Uses'
  checkoutWeb -> paymentService 'Calls'
  // The event spine, the async mirror of `metadata { op }`: the name must be a
  // message payment-service's own asyncapi.yaml declares an `action: send` for,
  // or `spine.message-undefined` fires. A consumer's edge carries
  // `metadata { consumes }` instead, and its name has to have a producer
  // SOMEWHERE in the fleet — the one check no single repository can answer.
  paymentService -> kafka.paymentEvents 'Publishes PaymentAuthorized' {
    metadata {
      publishes 'payment.PaymentAuthorized'
    }
  }
}

// Views are LikeC4's renderer's, never loam's — nothing below is read by any
// check. Two of them rather than one `include *`, because at fleet scale a
// single view holding every call is both the slow one to compute and the one
// nobody can read: the synchronous map and the event spine answer different
// questions and belong on different pages.
views {
  view landscape {
    title 'Fleet — calls between our own services'
    include *
    exclude element.tag = #external
  }

  view events {
    title 'Fleet — the event spine'
    include kafka, kafka.*, * -> kafka.*, kafka.* -> *
  }
}
