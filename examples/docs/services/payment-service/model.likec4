// payment-service's own C4 — what is INSIDE the element the fleet map binds to
// services/payment-service/. Written by an agent from the `loam adopt` brief,
// then curated.
//
// An EXTENDING model: no `specification` block of its own, no copy of any
// partner. The kinds (`container`, `database`) and every element this file
// points at are declared once in architecture/landscape.likec4, and the root
// `likec4.config.json` does not exclude `services/**`, so the map and every
// model are one LikeC4 project. `extend` takes the FULLY-QUALIFIED id — the
// element is nested in the `marketplace` group, so `extend paymentService`
// would resolve to nothing.
//
// There is no likec4.config.json beside this file and loam never writes one for
// an extending model: it belongs to the root project, so `npx likec4 start` at
// the docs root already draws it beside the map. SCHEMA.md, "Two shapes of a
// service model", has the other shape and the migration recipe.
model {
  extend marketplace.paymentService {
    api = container 'api' {
      description 'REST API'
      technology 'Spring Boot'
    }
    domain = container 'domain' {
      description 'Payment domain logic'
      technology 'Java'
    }
    // The store is a container of THIS service, not a fleet-level peer. Drawn
    // in the landscape it would be a system in its own right, available to be
    // depended on — which is the claim `landscape.datastore-private` exists to
    // refuse when only one service reaches it.
    db = database 'db' {
      description 'Payments store'
      technology 'PostgreSQL'
    }
    outbox = database 'outbox' {
      description 'Transactional outbox drained by the relay'
      technology 'PostgreSQL'
    }

    api -> domain 'Uses'
    domain -> db 'Reads/writes'
    domain -> outbox 'Appends events in the state-change transaction'
  }

  // Everything the service touches across its own boundary, drawn from the
  // container that really touches it to the other party's element AS THE MAP
  // SPELLS IT — never a copy of that element. The landscape carries only the
  // service-level crossing; these three edges say which container makes it.
  // health.yaml's three dependencies resolve through them
  // (`health.dependency-unmodelled` otherwise): `identity-service` through the
  // binding on the map's element, `stripe` by its id, and `kafka` because a
  // partner brings its ancestors — the edge names the TOPIC and the broker
  // answers for it.
  marketplace.paymentService.outbox -> kafka.paymentEvents 'Relay publishes payment events'
  marketplace.paymentService.domain -> marketplace.identityService 'Validates the caller token'
  marketplace.paymentService.domain -> stripe 'Authorizes and captures cards'
}

// Views are the LikeC4 renderer's, never loam's. This file is part of the root
// project, so `npx likec4 start` at the docs root draws this view beside the
// fleet map with nothing else to write.
views {
  view payment_service of marketplace.paymentService {
    include *
  }
}
