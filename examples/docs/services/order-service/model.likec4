// order-service's own C4 — what is INSIDE the element the fleet map binds to
// services/order-service/.
//
// This is an EXTENDING model: it declares no `specification` block, so every
// kind and tag it uses comes from architecture/landscape.likec4, and it declares
// no partner of its own. The map already says that order-service exists, what it
// is called and which directory it binds to; this file says what is inside it,
// with `extend` on the fully-qualified id the map gave that element. The id has
// to be the full path — `extend orderService` resolves to nothing, because the
// element is nested in the `marketplace` group.
//
// Nothing here re-declares kafka, payment-service or identity-service. That is
// the whole point of the shape: the root likec4.config.json does not exclude
// `services/**`, so the map and every model are ONE LikeC4 project, an element
// is declared exactly once, and two documents cannot disagree about its tags or
// its description. A PARTNER is what this file refers to and never owns — the
// map's element, reached by the id the map spells. An element declared here
// outside `marketplace.orderService` would be `c4.element-unowned`.
//
// SCHEMA.md, "Two shapes of a service model", has the other shape (a model that
// declares its own `specification` and is parsed alone) and the recipe for
// migrating between them.
model {
  extend marketplace.orderService {
    api = container 'api' {
      description 'REST API: createOrder, getOrder, cancelOrder, and the deprecated createOrderV1'
      technology 'Spring Boot'
    }
    domain = container 'domain' {
      description 'Order state machine; calls payment-service before an order is acknowledged'
      technology 'Kotlin'
    }
    // The two background containers exist in this model because arch.spec.md has to
    // be able to point at them: ARCH-ORD-OUTBOX and ARCH-ORD-DEDUPE cover them by id,
    // and an obligation whose subject is not modelled is an obligation no `Covers:`
    // line can name. Written the way the map spells them —
    // `marketplace.orderService.outbox` — because that is the id this file makes.
    outbox = container 'outbox-relay' {
      description 'Publishes committed outbox rows to order.events.v1 — at-least-once'
      technology 'Kotlin'
    }
    consumer = container 'payment-consumer' {
      description 'Applies payment.PaymentAuthorized once per paymentId, then advances the order'
      technology 'Kotlin'
    }
    // The store is a NESTED container of this service, never a fleet-level peer: it
    // has exactly one consumer, so drawn beside the services in the landscape it would
    // read as a system in its own right (`landscape.datastore-private` is the check
    // that pushes it back in here). Nesting hides nothing — a second service reaching
    // the same data earns `landscape.datastore-shared`, counted from that service's own
    // model — but it does decide where the store may be written: an edge naming
    // `marketplace.orderService.db` resolves only for a project that holds this file,
    // so a store two services will share belongs on the map inside `marketplace.orderService`.
    // The `database` kind is the landscape's, declared there once for every model that needs it.
    db = database 'db' {
      description 'Orders, idempotency keys, the applied-payment ledger and the outbox table'
      technology 'PostgreSQL'
    }

    // The internal edges, written INSIDE the extend block, where the children
    // resolve by their short names.
    api -> domain 'Places, reads and cancels'
    domain -> db 'Writes the order, its idempotency key and its outbox row in one transaction'
    outbox -> db 'Polls unpublished outbox rows and marks them sent'
    consumer -> db 'Records the applied paymentId, then advances the order'
  }

  // The cross-boundary edges, drawn OUTSIDE the extend block, from the container
  // that really makes each call to the other party's element as the MAP spells
  // it — which is the half of the truth the landscape cannot hold, since the map
  // carries only the service-level crossing. This file names no `kafka` of its
  // own: `kafka.orderEvents` is the map's topic, and pointing at it is what makes
  // health.yaml's `kafka` dependency resolve (a partner brings its ancestors with
  // it, so the broker answers even though only its topic is named).
  //
  // The `metadata` blocks below are not read for a service model — only landscape
  // edges feed `spine.op-*` and the event spine — but they are written anyway so the
  // two documents cannot drift into disagreeing about which operation and which
  // message each edge stands for. A model with elements and no relationships beside
  // a health.yaml declaring two dependencies is `c4.no-relationships`: a service
  // that reaches nothing is almost never true.
  marketplace.orderService.domain -> marketplace.paymentService 'Calls authorizePayment' {
    metadata {
      op 'authorizePayment'
    }
  }
  // ORD-CANCEL's `Requires: user/orders:cancel` has to be enforced somewhere, and this
  // is that edge: the API introspects the caller's token before it will cancel anything.
  // Drawn here and absent from health.yaml, which states the asymmetry and the reason.
  marketplace.orderService.api -> marketplace.identityService 'Calls introspectToken' {
    metadata {
      op 'introspectToken'
    }
  }
  marketplace.orderService.outbox -> kafka.orderEvents 'Publishes OrderPlaced' {
    metadata {
      publishes 'order.OrderPlaced'
    }
  }
  // Drawn topic → consumer, the direction the landscape uses and the one the
  // event spine requires there: `consumes` binds the edge's TARGET, so the same
  // edge drawn the other way round binds to nothing. Nothing grades it in a
  // service model, which is exactly why it follows the same convention — a
  // reader who learns the arrow here should not have to unlearn it upstairs.
  kafka.paymentEvents -> marketplace.orderService.consumer 'PaymentAuthorized advances the order' {
    metadata {
      consumes 'payment.PaymentAuthorized'
    }
  }
}

// Views are the LikeC4 renderer's, never loam's — no check reads this block. Scoped
// to the service's element, because "what does an order stand on" is this file's
// question and the fleet-wide one is already answered in architecture/landscape.likec4.
// This file is part of the ROOT project, beside the map: `npx likec4 start` at the
// docs root draws it, and there is no per-service likec4.config.json to write.
// View ids are flat across the whole project, so this one is spelled to be unique.
views {
  view order_service of marketplace.orderService {
    title 'order-service — containers, its store, and what it reaches'
    include *
    include marketplace.paymentService, marketplace.identityService, kafka, kafka.*
  }
}
