// identity-service's own C4 — what is INSIDE the element the fleet map binds to
// services/platform/identity-service/: the containers behind the token API and
// the two stores they reach.
//
// An EXTENDING model. There is no `specification` block here and there must not
// be one: the kinds come from architecture/landscape.likec4, which is read as
// part of the SAME LikeC4 project (the root `likec4.config.json` excludes
// `**/node_modules/**` and `features/**`, and nothing under `services/`). A
// second declaration of a kind the map already declares is a duplicate error
// blamed on both files. `extend` takes the fully-qualified id the map minted —
// `marketplace.identityService` — because the element is nested in the
// `marketplace` group; `extend identityService` resolves to nothing.
//
// Where the service sits in the SUBSYSTEM tree changes none of this: the model
// is found by walking `services/`, and `services/platform/` is a grouping
// directory, never part of any id. SCHEMA.md, "Two shapes of a service model",
// has the standalone shape and the recipe for migrating a model to this one.
model {
  extend marketplace.identityService {
    api = container 'api' {
      description 'HTTP surface: POST /tokens, POST /tokens/introspect, GET /tokens/{token}/valid'
      technology 'Go'
    }
    tokens = container 'tokens' {
      description 'Mints and signs tokens, and turns a recorded revocation into an inactive verdict'
      technology 'Go'
    }
    // Everything durable is in ONE store on purpose, and the description says
    // which things, because two documents downstream depend on it: the cache
    // requirement in arch.spec.md falls back HERE for a verdict, and the
    // stampede in runbook.md is issuance and introspection contending for this
    // store's connection pool. Naming only the signing keys here would leave
    // both of them reaching for state nothing in this model holds.
    keyStore = database 'key-store' {
      description 'Signing keys and their rotation state, the client registry, and the revocations a verdict is computed from — the only durable state this service owns'
      technology 'PostgreSQL'
    }
    // Derived state, so a plain container rather than a `database`: losing every
    // byte in here costs latency and never correctness, and ARCH-INTROSPECT-CACHE
    // in arch.spec.md is the requirement that says so in a scenario.
    //
    // Both stores stay NESTED inside the service boundary. Lifting either into
    // architecture/landscape.likec4 as a peer is `landscape.datastore-private`:
    // drawn at fleet level a store reads as a system in its own right, available
    // for somebody else's service to depend on, which is the one coupling that is
    // hardest to undo once a second team believes the picture. The extending
    // shape makes that the default rather than a discipline — internals are
    // written where they belong because there is nowhere else to write them.
    introspectionCache = container 'introspection-cache' {
      description 'Short-TTL introspection verdicts, keyed by token id'
      technology 'Redis'
    }

    api -> tokens 'Issues tokens, answers introspection and the legacy check'
    // These three edges are the WHOLE runtime graph of this service:
    // identity-service is the fleet's root of trust and calls nothing outside
    // its own boundary, which is why health.yaml carries no `dependencies:`
    // key, and why this model draws no cross-boundary edge at all. They still
    // have to be drawn — with four nested elements and no edge joining any of
    // them this model is `c4.no-relationships`, on the grounds that parts which
    // reach nothing are almost never the truth. (The check is evidence-gated:
    // one lone container proves nothing and stays silent, which is why the
    // warning is about a model this shape and not about any model.)
    tokens -> keyStore 'Signs with the active key; rotation promotes the next; introspection reads keys and revocations back'
    tokens -> introspectionCache 'Caches introspection verdicts, invalidates on revocation'
  }
}

// Views belong to LikeC4's renderer; no loam check reads anything below. One
// view is enough here because the whole model fits inside one boundary — the
// landscape splits its views only because a fleet-wide `include *` is the page
// nobody can read. View ids are flat across the whole project now that the map
// and every model share one, so this one is spelled to be unique.
views {
  view identity_service of marketplace.identityService {
    title 'identity-service — containers'
    include *
  }
}
