// notification-service's own C4 — what is INSIDE the element the fleet map binds
// to services/platform/notification-service/. Written by an agent from the
// `loam adopt` brief, then curated.
//
// An EXTENDING model: no `specification` block, no partner copies. The topics
// this service consumes — `kafka.orderEvents`, `kafka.paymentEvents`,
// `kafka.crmEvents` — are the MAP's, declared there once with the `topic` kind
// that carries `#external` and `#platform`; this file points at them. So is
// `notificationProvider`, the third-party gateway: a system this service reaches
// belongs in architecture/landscape.likec4, and declaring a copy of it here
// would be `c4.element-unowned`. `extend` takes the fully-qualified id because
// the element is nested in the `marketplace` group.
//
// SCHEMA.md, "Two shapes of a service model", has the standalone shape — a model
// that declares its own `specification` and is therefore parsed alone — and the
// ordered recipe for migrating one to this shape.
model {
  extend marketplace.notificationService {
    consumer = container 'consumer' {
      description 'Kafka consumer group; one handler per message name'
      technology 'Go'
    }
    sender = container 'sender' {
      description 'Renders a template and hands it to the email/SMS provider'
      technology 'Go'
    }
    // Both stores are nested INSIDE the service and neither is drawn beside it
    // in the landscape: a store with one consumer drawn as a fleet-level peer
    // reads as a system other services may depend on, which is what
    // `landscape.datastore-private` pushes back on. Neither appears in
    // health.yaml's dependencies either — they share this service's lifecycle
    // rather than being something it reaches across a boundary.
    deliveryLog = database 'delivery-log' {
      description 'One row per (message id, channel) — the idempotency key that makes redelivery a no-op — carrying the orderId and customer each send was addressed to, so a receipt can find its order and a capture that arrives first has somewhere to wait'
      technology 'PostgreSQL'
    }
    // The state NTF-CONTACT is entirely about, and it cannot be a corner of the
    // delivery log: that table is keyed by message and holds nothing per
    // customer, so it has no place to put a `version` to compare an update
    // against. Without this element the spec promises a versioned copy of every
    // customer address that the model gives nowhere to live — a divergence no
    // loam check catches, because loam grades that health.yaml's dependencies
    // resolve here and never that the requirements do.
    contacts = database 'contacts' {
      description 'The copy of each customer email and phone this service sends to, with the CRM version that decides whether an arriving update is newer'
      technology 'PostgreSQL'
    }

    consumer -> deliveryLog 'Claims a delivery before sending'
    consumer -> contacts 'Applies a CRM update only when its version is newer'
    consumer -> sender 'Hands off a rendered notification'
    sender -> contacts 'Reads the address a notification goes to'
    sender -> deliveryLog 'Records delivered / failed'
  }

  // The three channels this service takes messages off, pointing at the map's
  // topics. health.yaml names `kafka` as a critical dependency and that id has to
  // resolve through this model (`health.dependency-unmodelled` otherwise): it
  // does, because a partner brings its ANCESTORS with it — the edges name the
  // topics and the broker answers for them.
  //
  // No `metadata { consumes }` on these edges, and adding it would change
  // nothing: loam reads the event spine off `architecture/landscape.likec4`
  // alone, never off a service model. What resolves a consumed name against
  // asyncapi.yaml is each requirement's `Consumes:` line
  // (`spec-event.message-undefined` when one names a message no `action:
  // receive` operation declares); what the landscape settles is the other
  // half — that somebody, inside the fleet or tagged #external, publishes it.
  // These three edges are here for the picture only, and they earn it: this
  // model, the three channels in asyncapi.yaml and the three topics the runbook
  // names agree, or one of the three is out of date.
  // Drawn topic → consumer, the direction the landscape uses and the one the
  // event spine requires there: `consumes` binds the edge's TARGET, so the same
  // edge drawn the other way round binds to nothing at all.
  kafka.orderEvents -> marketplace.notificationService.consumer 'OrderPlaced triggers the confirmation'
  kafka.paymentEvents -> marketplace.notificationService.consumer 'PaymentCaptured triggers the receipt'
  kafka.crmEvents -> marketplace.notificationService.consumer 'CustomerUpdated refreshes contact details'

  // The second thing this service reaches across its own boundary, and the one
  // the runbook spends an incident section on: while the provider is down or
  // throttling, nothing is delivered and there is no fallback path. Its element
  // is the map's, and the map also carries the SERVICE-level twin of this edge
  // (`marketplace.notificationService -> notificationProvider`), because every
  // fleet check reads the map alone. The cross-boundary call is written twice on
  // purpose — container-level here, service-level there — and that remainder is
  // recorded in ROADMAP.md rather than hidden.
  marketplace.notificationService.sender -> notificationProvider 'Sends email and SMS, and backs off on 429'
}

// Views belong to LikeC4's renderer; no loam check reads anything below. This
// file is part of the root project, so `npx likec4 start` at the docs root draws
// this view beside the fleet map — there is no per-service likec4.config.json,
// and loam never writes one beside an extending model.
views {
  view notification_service of marketplace.notificationService {
    include *
  }
}
