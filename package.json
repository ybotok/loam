{
  "name": "@ybotok/loam",
  "version": "0.2.0-alpha.5",
  "description": "Architecture-first semantic integrity and change governance for evolving software systems: connect C4, requirements, contracts, and verification evidence.",
  "author": "spentsov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ybotok/loam.git"
  },
  "homepage": "https://github.com/ybotok/loam#readme",
  "bugs": {
    "url": "https://github.com/ybotok/loam/issues"
  },
  "keywords": [
    "architecture",
    "architecture-governance",
    "c4",
    "distributed-systems",
    "gherkin",
    "microservices",
    "modular-monolith",
    "semantic-integrity",
    "spec-driven-development"
  ],
  "type": "module",
  "bin": {
    "loam": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "CHANGELOG.md",
    "COMPARISON.md",
    "CONTRIBUTING.md",
    "MIGRATING-from-OpenSpec.md",
    "QUICKSTART.md",
    "ROADMAP.md",
    "SCHEMA.md",
    "SECURITY.md",
    "WORKFLOW.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "oxlint -D correctness --import-plugin --promise-plugin --node-plugin --deny-warnings src test scripts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "arch:graph": "node scripts/package-graph.mjs",
    "arch:check": "node scripts/arch-check.mjs",
    "meta:model": "node scripts/self-model.mjs --print",
    "meta:agents": "tsx scripts/meta-agents.ts",
    "meta:check": "node scripts/self-model.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:check:selftest": "node scripts/release-check.mjs --fixture-ready",
    "release:pack": "node scripts/pack-release.mjs",
    "test:openspec-corpus": "tsx scripts/check-openspec-corpus.ts",
    "bench:validate": "tsx scripts/bench-validate.ts",
    "setup": "bash scripts/setup.sh"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "likec4": "1.59.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
