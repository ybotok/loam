{
  "name": "@spentsov/loam",
  "version": "0.1.0-beta.1",
  "description": "Architecture-first spec framework for microservice fleets: reverse-engineer service docs from code, drive cross-service features from C4 deltas.",
  "author": "spentsov",
  "keywords": [
    "architecture",
    "c4",
    "gherkin",
    "microservices",
    "spec-driven-development"
  ],
  "type": "module",
  "bin": {
    "loam": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "test:openspec-corpus": "tsx scripts/check-openspec-corpus.ts",
    "setup": "bash scripts/setup.sh"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "likec4": "1.59.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
