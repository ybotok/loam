{
  "name": "@ybotok/loam",
  "version": "0.1.0-beta.1",
  "description": "Architecture-first spec framework for microservice fleets: reverse-engineer service docs from code, drive cross-service features from C4 deltas.",
  "author": "spentsov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergeyPentsov/loam.git"
  },
  "homepage": "https://github.com/SergeyPentsov/loam#readme",
  "bugs": {
    "url": "https://github.com/SergeyPentsov/loam/issues"
  },
  "keywords": [
    "architecture",
    "c4",
    "gherkin",
    "microservices",
    "spec-driven-development"
  ],
  "type": "module",
  "bin": {
    "loam": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "COMPARISON.md",
    "MIGRATING-from-OpenSpec.md",
    "SCHEMA.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "oxlint -D correctness --import-plugin --promise-plugin --node-plugin --deny-warnings src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:check:selftest": "node scripts/release-check.mjs --fixture-ready",
    "release:pack": "node scripts/pack-release.mjs",
    "pilot:run": "node scripts/pilot-harness.mjs",
    "pilot:check": "node scripts/pilot-harness.mjs --check-manifest docs/pilot/manifest.example.json --selftest",
    "test:openspec-corpus": "tsx scripts/check-openspec-corpus.ts",
    "setup": "bash scripts/setup.sh"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "likec4": "1.59.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
