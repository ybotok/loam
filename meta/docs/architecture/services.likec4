// generated by loam — one overview view per service under services/, drawn from the fleet map.
// Do not edit: `loam subsystem sync` regenerates this file from the directories and the map,
// and `loam validate --all` reports `subsystem.views-stale` when it drifts.
// A navigation aid, not the fleet's architecture: author your own diagrams elsewhere.

views {
  view service_loam of loam {
    title 'loam'
    include *
    exclude * -> *
    include -> loam
    include loam ->
    include loam.* -> loam.*
  }
}
