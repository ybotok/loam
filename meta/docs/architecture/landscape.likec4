// loam's own architecture, drawn in loam. This is the SELF-MODEL: `services/loam/`
// is loam itself, and the boxes below are the directories of `src/` in this very
// repository. Nothing else in this docs tree describes another system, because
// there is not another one — loam is a single binary, and ROADMAP.md's
// "Self-hosting: loam on loam" is the standing statement of what that costs.
//
// THE COLLAPSE RULE, and it is the whole design of this file. `src/` holds 424
// modules in 129 package directories (`npm run arch:graph` prints both). Drawing
// 129 boxes would model the tree's INDENTATION; drawing three would model
// nothing. The unit here is the TOP-LEVEL SUBJECT — exactly what
// `docs/DESIGN.md`'s package-layout table has one row for:
//
//     src/cli.ts               -> loam.cli
//     src/core/<name>/**       -> loam.core.<name>         (37 packages)
//     src/core/<name>.ts       -> loam.core.<name>         (the 4 loose modules)
//     src/commands/<name>/**   -> loam.commands.<name>     (24, policy included)
//     src/commands/<name>.ts   -> loam.commands.<name>     (the 5 loose modules)
//
// 71 containers, and one edge for every VALUE import that crosses two of them:
// 427 of them — 165 inside core, 196 from a command into core, 37 command to
// command, 29 out of cli.ts and the loose modules. A `-` in a directory name
// becomes `_` in the element name, because a LikeC4 element name is an
// identifier and `conflict-markers` would parse as a subtraction. The real path
// is the TITLE, and `scripts/self-model.mjs` checks the title as strictly as it
// checks the id — so the rename is recorded, not hidden.
//
// `loam.core` and `loam.commands` are GROUPINGS. They stand for no package and
// hold no module of their own — `src/core/*.ts` and `src/commands/*.ts` are each
// their own unit above — so the self-model check reads only the LEAVES as units.
// An element with children is scenery; an element without is a claim.
//
// WHY ONE softwareSystem WITH EVERYTHING NESTED INSIDE IT, rather than one
// service per subsystem. Two reasons, both mechanical rather than aesthetic:
//   - SCHEMA.md puts every subsystem name and every service id in ONE FLAT
//     namespace, and `core/` and `commands/` collide on eleven leaf names
//     (delta, dependencies, diff, doctor, explain, explore, gate, gherkin, mcp,
//     status, verify). A services/core/ + services/commands/ tree cannot be
//     spelled at all — it is not a preference that was weighed and lost.
//   - An element is graded at service level only when NO ancestor already stands
//     for a service (`validate/fleet/census.ts`), so one `metadata { service }`
//     on the root puts all 70 boxes on the map while
//     `landscape.service-undocumented` stays correctly silent: none of them is a
//     service, and none of them owes a directory under `services/`.
//
// NO `description` ON A PACKAGE, deliberately. Nothing checks a description, and
// `docs/DESIGN.md`'s package-layout table is already the reviewed English for
// these subjects; a second copy here would be a second thing to drift, with no
// gate between them and no way to tell which one had rotted. What this file
// states is what a machine can hold it to: the id, the title, and the edge.
//
// WHAT KEEPS IT TRUE — and it is not `loam validate`. loam reads no source tree,
// by standing non-goal, so "a package with no box" and "a box with no package"
// are questions it will never answer about anybody's repository, this one
// included. `npm run meta:check` (`scripts/self-model.mjs`) answers them, in
// both directions, over the same import graph `npm run arch:check` walks. It
// prints the fix and never applies it; if it ever grows a `--write`, the
// non-goal has been broken.


specification {
  // Two kinds, and the scaffold's other two are deleted rather than left
  // unused. `person` has no subject here — nobody is drawn using loam, because
  // what would be drawn is a terminal. `database` is refused on purpose: the
  // nearest candidates are `core/staging/` (the write path) and `core/repo/`
  // (the read model over the docs tree), and drawing either as a datastore
  // fires `landscape.datastore-private` / `landscape.datastore-shared`, which
  // are advisories about a fleet-level store two services share. Neither is
  // one, and a warning with no correct fix is a warning somebody silences.
  element softwareSystem
  element container
}

model {
  loam = softwareSystem 'loam' {
    // The binding that makes services/loam/ this element's directory, and the
    // one line that keeps 70 containers off the service census: an element is
    // graded at service level only when no ancestor already stands for a
    // service, and this is that ancestor.
    metadata {
      service 'loam'
    }

    cli = container 'src/cli.ts'

    core = container 'src/core/' {
      agent = container 'src/core/agent/'
      asyncapi = container 'src/core/asyncapi/'
      brief = container 'src/core/brief/'
      c4 = container 'src/core/c4/'
      capabilities = container 'src/core/capabilities/'
      coherence = container 'src/core/coherence/'
      conflict_markers = container 'src/core/conflict-markers.ts'
      delta = container 'src/core/delta/'
      dependencies = container 'src/core/dependencies/'
      diff = container 'src/core/diff/'
      docs = container 'src/core/docs.ts'
      doctor = container 'src/core/doctor/'
      document = container 'src/core/document/'
      envelope = container 'src/core/envelope/'
      explain = container 'src/core/explain/'
      explore = container 'src/core/explore/'
      fleet_context = container 'src/core/fleet-context.ts'
      gate = container 'src/core/gate/'
      gherkin = container 'src/core/gherkin/'
      glossary = container 'src/core/glossary/'
      kernel = container 'src/core/kernel/'
      links = container 'src/core/links/'
      mcp = container 'src/core/mcp/'
      obligations = container 'src/core/obligations/'
      openapi = container 'src/core/openapi/'
      openspec = container 'src/core/openspec/'
      owners = container 'src/core/owners/'
      pack = container 'src/core/pack/'
      permissions = container 'src/core/permissions/'
      projection = container 'src/core/projection/'
      provenance = container 'src/core/provenance/'
      repo = container 'src/core/repo/'
      results = container 'src/core/results.ts'
      scaffold = container 'src/core/scaffold/'
      staging = container 'src/core/staging/'
      status = container 'src/core/status/'
      usecases = container 'src/core/usecases/'
      verify = container 'src/core/verify/'
      vocabulary = container 'src/core/vocabulary/'
      workspace = container 'src/core/workspace/'
      deployment = container 'src/core/deployment/'
    }

    commands = container 'src/commands/' {
      adopt = container 'src/commands/adopt/'
      archive = container 'src/commands/archive/'
      context = container 'src/commands/context/'
      delta = container 'src/commands/delta/'
      dependencies = container 'src/commands/dependencies.ts'
      diff = container 'src/commands/diff/'
      doctor = container 'src/commands/doctor.ts'
      explain = container 'src/commands/explain/'
      explore = container 'src/commands/explore.ts'
      gate = container 'src/commands/gate/'
      gherkin = container 'src/commands/gherkin/'
      init = container 'src/commands/init/'
      instructions = container 'src/commands/instructions.ts'
      list = container 'src/commands/list/'
      mcp = container 'src/commands/mcp/'
      migrate_openspec = container 'src/commands/migrate-openspec/'
      new = container 'src/commands/new/'
      open = container 'src/commands/open.ts'
      policy = container 'src/commands/policy/'
      rebase = container 'src/commands/rebase/'
      seed = container 'src/commands/seed/'
      show = container 'src/commands/show/'
      status = container 'src/commands/status/'
      steps = container 'src/commands/steps/'
      subsystem = container 'src/commands/subsystem/'
      unarchive = container 'src/commands/unarchive/'
      validate = container 'src/commands/validate/'
      verify = container 'src/commands/verify/'
      vouch = container 'src/commands/vouch/'
    }
  }

  // ONE EDGE PER VALUE IMPORT THAT CROSSES TWO UNITS, and nothing else. The
  // list is derived from `scripts/source-graph.mjs` — the same walk
  // `npm run arch:check` runs — and `npm run meta:check` fails on an edge here
  // the tree does not have, and on one the tree has and this file does not.
  //
  // `import type` is NOT an edge, on both sides of that check, because
  // `verbatimModuleSyntax` erases it: a type-only edge cannot make
  // module-evaluation order decide behaviour, which is the whole reason the
  // acyclicity rules exist. The exemption has to be the same exemption on both
  // sides or this file would be told to draw an edge arch:check has already
  // decided is not one — which is why both readers share one module.
  //
  // TWO MUTUAL DEPENDENCIES ARE DRAWN HERE AND ARE REAL:
  // `core/c4` <-> `core/repo` and `core/repo` <-> `core/provenance`. They are
  // invisible to `npm run arch:graph`, which keys on the FULL relative
  // directory — `core/c4/project` and `core/c4` are different nodes there, so
  // the graph it proves acyclic is a finer one than the subjects
  // `docs/DESIGN.md`'s package-layout table names. The table's claim is
  // qualified accordingly, and `scripts/self-model.mjs` holds the qualified
  // version: its baseline lists exactly these two, and a third fails the build.


  loam.cli -> loam.commands.adopt
  loam.cli -> loam.commands.archive
  loam.cli -> loam.commands.context
